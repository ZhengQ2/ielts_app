{
  "name": "@ielts-map/ingest",
  "version": "0.1.0",
  "private": true,
  "description": "IELTS.org master ingestion: sitemap → centre pages → parse → dedup → geocode → dataset",
  "type": "module",
  "bin": {
    "ielts-ingest": "./src/cli.ts"
  },
  "scripts": {
    "ingest": "node --experimental-strip-types src/cli.ts",
    "availability": "node --experimental-strip-types src/availability-cli.ts",
    "availability:idp-global-full-scale": "node --experimental-strip-types src/idp-global-full-scale-cli.ts",
    "availability:idp-india-pilot": "node --experimental-strip-types src/idp-india-pilot-cli.ts",
    "availability:idp-global-api-probe": "node --experimental-strip-types src/idp-global-api-probe-cli.ts",
    "availability:surface-probe": "node --experimental-strip-types src/provider-surface-probe-cli.ts",
    "localize": "node --experimental-strip-types src/localize-cli.ts",
    "neutral-pilot": "node --experimental-strip-types src/neutral-pilot-cli.ts",
    "apple-map-pilot": "node --experimental-strip-types src/apple-map-pilot-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ielts-map/core": "*"
  },
  "devDependencies": {
    "playwright-core": "^1.54.1"
  }
}
