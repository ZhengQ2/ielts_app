# Copy to .env.local (gitignored) and fill in. Everything here is OPTIONAL —
# the pipeline and the app both run with no credentials at all.

# Google Geocoding + Places API (New) key. Address geocoding and venue-name
# search are separate evidence paths. Restrict this server key to only those
# two APIs. Used only at ingest time; the web app never sees it.
#
# Retention note: Google's Maps Platform terms cap how long their geocoding
# results may be cached, and Place IDs are the documented exception. Keep the
# scheduled re-crawl (M1.5) running so committed coordinates stay fresh, or
# fall back to Nominatim, whose ODbL data has no such limit.
GOOGLE_MAPS_API_KEY=

# Google Maps JavaScript browser credential. Use a separate key restricted to
# http://localhost:3000/* and https://ielts.zhengqiu.net/* and restrict it to
# the Maps JavaScript API. This value is intentionally included in the browser
# bundle; the referrer restriction is the security boundary.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=6ec1a893e236fefc45f44f43

# Country-specific ingest-time fallback keys. AMap is consulted only for a
# still-coarse mainland-China result; Mappls only for a still-coarse India
# result. Neither key is included in the web bundle.
AMAP_API_KEY=
# Optional AMap account/network tuning. Defaults stay below the basic-service
# QPS window and bound one slow request so a refresh cannot hang indefinitely.
AMAP_MIN_INTERVAL_MS=350
AMAP_REQUEST_TIMEOUT_MS=8000
MAPPLS_API_KEY=
# Keep Mappls calls serialized within one ingest process. Adjust only when the
# account dashboard documents a different per-key QPS allowance.
MAPPLS_MIN_INTERVAL_MS=250
# Per-attempt deadline for Google/Mappls requests; transient failures retry.
PROVIDER_REQUEST_TIMEOUT_MS=8000
