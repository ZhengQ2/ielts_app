{
  "name": "ielts-map",
  "private": true,
  "version": "0.1.0",
  "description": "IELTS test centre directory — neutral, all-operator, ratings layered on top",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bash scripts/dev-web.sh",
    "build": "bash scripts/build-web.sh",
    "start": "npm run start --workspace @ielts-map/web",
    "lint": "npm run lint --workspace @ielts-map/web",
    "typecheck": "tsc -b packages/core packages/ingest --pretty",
    "test": "node --test --experimental-strip-types \"packages/*/test/*.test.ts\"",
    "ingest": "npm run ingest --workspace @ielts-map/ingest --",
    "availability": "npm run availability --workspace @ielts-map/ingest --",
    "availability:idp-global-full-scale": "npm run availability:idp-global-full-scale --workspace @ielts-map/ingest --",
    "availability:idp-india-full-scale": "npm run availability:idp-india-full-scale --workspace @ielts-map/ingest --",
    "availability:idp-china-full-scale": "npm run availability:idp-china-full-scale --workspace @ielts-map/ingest --",
    "availability:idp-india-pilot": "npm run availability:idp-india-pilot --workspace @ielts-map/ingest --",
    "availability:idp-global-api-probe": "npm run availability:idp-global-api-probe --workspace @ielts-map/ingest --",
    "availability:idp-china-api-probe": "npm run availability:idp-china-api-probe --workspace @ielts-map/ingest --",
    "availability:surface-probe": "npm run availability:surface-probe --workspace @ielts-map/ingest --",
    "localize": "npm run localize --workspace @ielts-map/ingest --",
    "neutral-pilot": "npm run neutral-pilot --workspace @ielts-map/ingest --",
    "apple-map-pilot": "npm run apple-map-pilot --workspace @ielts-map/ingest --",
    "deploy:aws": "bash scripts/deploy-aws.sh"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.7.3"
  }
}
